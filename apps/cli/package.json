    "@sandy/server-contract": "workspace:*",
    "@sandy/templates": "workspace:*",
    "@sandy/text-utils": "workspace:*",
    "@sandy/thread-view": "workspace:*",
    "sandy-plugin-sandy--git": "workspace:*",
    "sandy-plugin-sandy--github-pr-status": "workspace:*",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
