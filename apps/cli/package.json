{
  "name": "@sandy/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "sandy": "./bin/sandy",
    "title": "./bin/title"
  },
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --split",
