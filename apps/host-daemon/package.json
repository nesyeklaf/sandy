{
  "name": "@sandy/host-daemon",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-host-daemon.js && node ../../scripts/build-node-entry.mjs src/start-host-daemon.ts dist/start-host-daemon.js && node ../../scripts/build-node-entry.mjs src/plugin-host-worker.ts dist/plugin-host-worker.js && node ./scripts/build-bundles.mjs",
    "start": "node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@sandy/agent-runtime": "workspace:*",
    "@sandy/async-cache": "workspace:*",
    "@sandy/cli": "workspace:*",
    "@sandy/config": "workspace:*",
    "@sandy/domain": "workspace:*",
    "@sandy/file-transfer": "workspace:*",
    "@sandy/fuzzy-match": "workspace:*",
    "@sandy/host-daemon-contract": "workspace:*",
    "@sandy/host-watcher": "workspace:*",
    "@sandy/host-workspace": "workspace:*",
    "@sandy/local-open-targets": "workspace:*",
    "@sandy/logger": "workspace:*",
    "@sandy/process-utils": "workspace:*",
    "@sandy/provider-bridge-protocol": "workspace:*",
    "@sandy/server-archive": "workspace:*",
    "@sandy/skill-index": "workspace:*",
    "@sandy/telemetry": "workspace:*",
    "@sandy/text-utils": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@parcel/watcher": "2.5.6",
    "sandy-environment-provider-host": "workspace:*",
    "mime-types": "^3.0.2",
    "node-pty": "1.2.0-beta.15",
    "p-retry": "^6.2.1",
    "partysocket": "^1.3.0",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "4.0.2",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.7.4",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sandy/plugin-build": "workspace:*",
    "@sandy/scripts": "workspace:*",
    "@sandy/test-helpers": "workspace:*",
    "@sandy/tsconfig": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.0",
    "hono": "^4.7.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
