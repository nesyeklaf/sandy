{
  "name": "sandy-plugin-environment-project-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run a thread in the project's own checkout on an enrolled machine, on the branch you choose",
  "engines": {
    "sandy": ">=0.0"
  },
  "sandy": {
    "name": "Project checkout",
    "description": "Run a thread in the project's own checkout on an enrolled machine, on the branch you choose",
    "branding": {
      "icon": "Laptop"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "sandy-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "prepare:bundled": "sandy-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@sandy/shared-ui": "workspace:*",
    "sandy-environment-provider-host": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sandy/plugin-build": "workspace:*",
    "@sandy-sdk/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
