{
  "name": "sandy-plugin-sandy--git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git status, changed files and the Diff tab for each environment",
  "engines": {
    "sandy": ">=0.0",
    "sandyPluginSdk": ">=0.6.90"
  },
  "sandy": {
    "name": "Git",
    "description": "Git status, changed files and the Diff tab for each environment",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "exports": {
    "./contract": "./contract.ts",
    "./rpc-contract": "./rpc-contract.ts",
    "./status-state": "./status-state.ts",
    "./testing": "./testing.ts"
  },
  "keywords": [
    "sandy-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "sandy-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@sandy/async-cache": "workspace:*",
    "@sandy/domain": "workspace:*",
    "@sandy/server-contract": "workspace:*",
    "@sandy/shared-ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.20",
    "sandy-environment-provider-host": "workspace:*",
    "mime-types": "^3.0.2",
    "picomatch": "^4.0.5",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sandy/host-daemon-contract": "workspace:*",
    "@sandy/plugin-build": "workspace:*",
    "@sandy/test-helpers": "workspace:*",
    "@sandy-sdk/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
