{
  "name": "sandy-plugin-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sandy's sidebar navigation: the Rail and Top list layouts for New thread, Plugins, Skills, Automations, and plugin panels.",
  "engines": {
    "sandy": ">=0.0",
    "sandyPluginSdk": ">=0.6.53"
  },
  "sandy": {
    "name": "Navigation",
    "description": "sandy's sidebar navigation: the Rail and Top list layouts for New thread, Plugins, Skills, Automations, and plugin panels.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "sandy-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "sandy-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@sandy/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@sandy/plugin-build": "workspace:*",
    "@sandy-sdk/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
