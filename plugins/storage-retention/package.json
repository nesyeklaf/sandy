{
  "name": "sandy-plugin-sandy--storage-retention",
  "version": "0.1.0",
  "description": "Inspect machine storage and automatically archive or delete old threads.",
  "private": true,
  "type": "module",
  "engines": {
    "sandy": ">=0.0",
    "sandyPluginSdk": ">=0.6.86"
  },
  "sandy": {
    "name": "Storage & retention [Experimental]",
    "description": "Inspect machine storage and automatically archive or delete old threads.",
    "branding": {
      "icon": "./icons/database-restore.svg"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./src/host.ts"
  },
  "keywords": [
    "sandy-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "sandy-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@sandy/domain": "workspace:^",
    "@sandy/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sandy/plugin-build": "workspace:*",
    "@sandy-sdk/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
