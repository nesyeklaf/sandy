{
  "format": "holon/v0",
  "id": "password-reset",
  "kind": "component",
  "partOf": "account",
  "title": "Password reset",
  "status": "active",
  "why": "A forgotten password should not turn into a support ticket.",
  "contract": "A reset link works once, for 30 minutes, for the address it was sent to.",
  "carriedBy": [
    "team-identity"
  ],
  "code": [
    "apps/account/reset.ts"
  ],
  "seams": [
    {
      "to": "mail",
      "contract": "Sends only to verified addresses",
      "readOnly": false,
      "proof": {
        "kind": "ci",
        "source": "apps/account/reset-mail.test.ts"
      }
    }
  ],
  "proofs": {
    "I": {
      "kind": "interview",
      "every": "90d"
    },
    "It": {
      "kind": "ci",
      "source": "apps/account/reset.test.ts",
      "every": "90d"
    },
    "We": {
      "kind": "metric",
      "source": "reset-tickets-per-month"
    },
    "They": {
      "kind": "alert",
      "source": "reset-mail-bounced",
      "every": "90d"
    }
  }
}
