{
  "name": "sandy-app",
  "version": "0.48.1",
  "description": "sandy app launcher for npx",
  "keywords": [
    "sandy",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/nesyeklaf/sandy#readme",
  "bugs": {
    "url": "https://github.com/nesyeklaf/sandy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesyeklaf/sandy.git",
    "directory": "packages/sandy-app"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/sandy-app.js": "./dist/sandy-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "sandy-app": "dist/sandy-app.js",
    "sandy": "dist/sandy.js",
    "sandy-server": "dist/sandy-server.js",
    "sandy-host-daemon": "dist/sandy-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "host-daemon/dist/sandy",
    "host-daemon/dist/sandy.cmd",
    "host-daemon/dist/sandy-chunks",
    "host-daemon/dist/sandy-parcel-watcher-child.mjs",
    "host-daemon/dist/sandy-plugin-host-worker.mjs",
    "host-daemon/dist/sandy-provider-bridge-worker.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "README.md",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-sandy-chunks.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "13.0.3",
    "fs-native-extensions": "1.5.0",
    "hono": "^4.7.0",
    "node-pty": "1.2.0-beta.15",
    "npm": "11.16.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "4.0.2",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sandy/config": "workspace:*",
    "@sandy/host-daemon-contract": "workspace:*",
    "@sandy/sdk": "workspace:*",
    "@sandy/server-archive": "workspace:*",
    "@sandy/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "semver": "^7.7.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1",
    "@sandy/process-utils": "workspace:*"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
