    "@sandy/process-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@sandy/test-helpers": "workspace:*",
    "@sandy/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1",
    "yaml": "^2.9.0"
  }
