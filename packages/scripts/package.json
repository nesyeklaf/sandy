{
  "name": "@sandy/scripts",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "bin": {
    "sandy-script-archive-codex-tmp-sandy-sessions": "./dist/commands/archive-codex-tmp-sandy-sessions.js",
    "sandy-script-reset-sandy-data": "./dist/commands/reset-sandy-data.js",
    "sandy-script-run-cli": "./dist/commands/run-cli.js"
  },
  "exports": {
    "./lib/run-dev-supervisor": {
      "source": "./src/lib/run-dev-supervisor.ts",
      "types": "./src/lib/run-dev-supervisor.ts",
      "import": "./dist/lib/run-dev-supervisor.js"
    }
  },
  "files": [
    "dist"
  ],
