{
  "name": "@sandy/provider-parity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
