  },
  "dependencies": {
    "@sandy/domain": "workspace:*",
    "@sandy/provider-bridge-protocol": "workspace:*",
    "@sandy/thread-view": "workspace:*"
  },
  "devDependencies": {
    "@sandy/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
