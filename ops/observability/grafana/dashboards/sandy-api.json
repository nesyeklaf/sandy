        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=\"sandy-server\",http_route=~\"$route\"}[$__range]))",
          "instant": true,
          "range": false,
