          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"sandy-server\",http_route=~\"$route\",http_route!~\"$streaming\"}[$__rate_interval])))",
          "legendFormat": "p99",
