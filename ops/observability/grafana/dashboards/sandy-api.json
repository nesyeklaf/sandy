      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"sandy-server\",http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true
