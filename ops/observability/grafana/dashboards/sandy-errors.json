          },
          "expr": "topk(25, sum by (pluginId, detected_level) (count_over_time({service_name=\"sandy-server\"} | pluginId!=\"\" | detected_level=~\"error|warn\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
