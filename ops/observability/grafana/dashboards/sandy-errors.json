            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1,
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "interval": "5m"
    },
    {
      "id": 11,
      "type": "table",
      "title": "Plugin errors and warnings",
      "description": "Records with a pluginId field, by plugin and level.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
