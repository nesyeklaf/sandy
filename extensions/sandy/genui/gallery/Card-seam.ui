view = Load("data/holon/view-account.json")
tone = l => l == "hard" ? "good" : l == "soft" ? "info" : l == "refuted" ? "bad" : l == "open" || l == "claimed" ? "neutral" : "warn"
seams = view.seams
detail = s => (view.focus.drift.find(d => d.seam == s.to && s.from == view.focus.id) ?? {detail: s.drift}).detail
Card(`${view.focus.title}: its seams`, [
  Table(["From", "To", "Contract", "Light", "Notes"], seams.map(s => [s.fromTitle, s.toTitle, s.contract, Badge(s.light, tone: tone(s.light)), [s.readOnly ? "read-only" : null, s.exclusive ? "exclusive" : null, s.drift].filter(n => n != null).join(", ")])),
  seams.filter(s => s.drift != null).map(s => Callout(`${s.fromTitle} → ${s.toTitle}: ${detail(s)}`, tone: "bad", title: `False promise: ${s.contract}`))
])
