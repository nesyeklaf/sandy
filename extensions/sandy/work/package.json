{
  "name": "sandy-plugin-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Delegates, tracks, workflows and goals as one SANDY plugin: one database, one host entry, one CLI (sandy work). The pi side is pi/work.",
  "scripts": {
    "test": "pnpm run test:work && pnpm run test:delegate && pnpm run test:track && pnpm run test:goals && pnpm run test:workflows",
    "test:work": "node --test --experimental-strip-types migrations.test.ts legacy-import.test.ts && vitest run --config vitest.config.ts",
    "test:delegate": "node --test --experimental-strip-types delegate/tests/*.test.ts",
    "test:track": "node --test --experimental-strip-types track/*.test.ts",
    "test:goals": "node --test --experimental-strip-types goals/*.test.ts",
    "test:workflows": "vitest run --root workflows --config vitest.config.ts",
    "typecheck": "tsc -p . && tsc -p track && tsc -p workflows"
  },
  "engines": {
    "sandy": ">=0.47",
    "sandyPluginSdk": ">=0.6.79"
  },
  "sandy": {
    "name": "Work",
    "description": "Delegated child agents, tracks with gated stages, workflows with reusable workers and pi goals, in one plugin.",
    "branding": {
      "icon": "Briefcase"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "track/skills",
      "workflows/skills"
    ]
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@radix-ui/react-slot": "^1.3.0",
    "acorn": "8.16.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.20.0",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sandy-sdk/plugin-sdk": "file:../../../packages/plugin-sdk",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
}
