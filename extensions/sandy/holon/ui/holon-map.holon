  "id": "holon-map",
  "kind": "container",
  "partOf": "holon-extension",
  "title": "Holon map",
  "why": "A holon is only understood in its neighbourhood, so the opener opens on a zoomable map of nested holons and their seams instead of a single card.",
  "contract": "Draws the holons as nested boxes with their four sides, the seams as labelled arrows bundled to the nearest visible box, and lets the reader open, close, pan, zoom and recolour by side before the card of the selected holon below.",
  "code": [
    "extensions/sandy/holon/ui/HolonMap.tsx",
    "extensions/sandy/holon/ui/holon-map-graph.ts",
    "extensions/sandy/holon/ui/holon-map-layout.ts"
  ],
  "seams": [
    {
      "to": "holon-cli",
      "contract": "Reads the whole model through the map RPC",
      "readOnly": true
    }
  ],
  "proofs": {
    "It": {
      "kind": "ci",
      "source": "extensions/sandy/holon/ui/holon-map.test.tsx"
    }
  }
}
