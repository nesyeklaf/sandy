{
  "name": "sandy-plugin-holon",
  "version": "0.1.0",
  "description": "SANDY plugin: holons as files in Git, checked, indexed and computed into lights, drift and views.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "sandy plugin build",
    "sync:holon-ui": "node scripts/sync-holon-ui.mjs"
  },
  "engines": {
    "sandy": ">=0.45",
    "sandyPluginSdk": ">=0.6.15"
  },
  "sandy": {
    "name": "Holons",
    "description": "Checks holon files, computes lights and drift, records evidence and edits holons in a thread's Holons tab.",
    "branding": {
      "icon": "Hierarchy"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sandy-sdk/plugin-sdk": "file:../../../packages/plugin-sdk",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
