{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "ES2024.String",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "cli.ts",
    "engine.ts",
    "error.ts",
    "root.ts",
    "render.ts",
    "core",
    "ui",
    "*.test.ts",
    "*.test.tsx",
    "test",
    "vitest.config.ts"
  ]
}
