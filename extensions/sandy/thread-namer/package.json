  "devDependencies": {
    "@sandy-sdk/plugin-sdk": "file:../../../packages/plugin-sdk",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
