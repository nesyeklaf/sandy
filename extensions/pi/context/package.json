{
	"name": "pi-context",
	"version": "0.1.0",
	"private": true,
	"description": "Cache-aware context management for long-running pi sessions (pi 1.3 or later): planned cuts, an anchored summary, pinned user messages, a notebook, search over the unchanged log, and one-token keep-warm requests for waiting sessions.",
	"type": "module",
	"files": [
		"index.ts",
		"src",
		"examples",
		"tools/measure.ts",
		"README.md"
	],
	"exports": {
		"./core": "./src/core/index.ts",
		"./pi": "./src/pi/extension.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"measure": "node --experimental-strip-types tools/measure.ts",
		"smoke": "node --experimental-strip-types tools/smoke-install.ts",
		"test:live": "node --experimental-strip-types test/live/run.ts --fast --thinking=low --watermark=20000"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@types/node": "24.19.2",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "4.1.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.3.0",
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
